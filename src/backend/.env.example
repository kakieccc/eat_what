DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/food_nav
AMAP_WEB_SERVICE_KEY=replace-with-amap-web-service-key
AMAP_TIMEOUT_SECONDS=4
AMAP_CONNECT_TIMEOUT_SECONDS=2
AMAP_POOL_TIMEOUT_SECONDS=1
AMAP_OPERATION_TIMEOUT_SECONDS=10
AMAP_REQUEST_CONCURRENCY=3
AMAP_ROUTE_CONCURRENCY=3
AMAP_REQUEST_INTERVAL_SECONDS=0.5
AMAP_CACHE_TTL_SECONDS=600
AMAP_ROUTE_CACHE_TTL_SECONDS=300
AMAP_EMPTY_CACHE_TTL_SECONDS=30
LLM_API_KEY=replace-with-llm-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=replace-with-model-id
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0
LLM_REASONING_EFFORT=low
